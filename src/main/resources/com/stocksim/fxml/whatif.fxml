<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" styleClass="content-scroll" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.WhatIfController"><VBox styleClass="page" spacing="10"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="What-If Simulator" styleClass="page-title"/><Label text="HYPOTHETICAL: revalues your current holdings. Nothing in your account changes." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="HYPOTHETICAL MOVEMENTS" styleClass="panel-title"/><HBox spacing="8" alignment="CENTER_LEFT"><ComboBox fx:id="scopeBox" prefWidth="120"/><ComboBox fx:id="targetBox" prefWidth="180"/><TextField fx:id="percentField" promptText="Change %, e.g. -15" onAction="#add" prefWidth="160"/><Button text="Add movement" onAction="#add" minWidth="-Infinity"/><Button text="Remove selected" onAction="#remove" minWidth="-Infinity"/></HBox><ListView fx:id="shockList" prefHeight="100" minHeight="80"/><HBox spacing="10"><Button text="Preview" onAction="#preview" minWidth="-Infinity"/><Button text="Run experiment" onAction="#run" styleClass="primary" minWidth="-Infinity"/><Button text="Reset" onAction="#reset" minWidth="-Infinity"/></HBox><Label text="" styleClass="accent" wrapText="true" minHeight="-Infinity" fx:id="messageLabel"/></VBox><VBox fx:id="resultBox" spacing="10"><Label text="" styleClass="summary" wrapText="true" minHeight="-Infinity" fx:id="summaryLabel"/><FlowPane fx:id="metrics" hgap="8" vgap="8" styleClass="metric-strip"/><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="BEFORE VS AFTER" styleClass="panel-title"/><StackPane fx:id="compareChart" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="SECTOR IMPACT" styleClass="panel-title"/><StackPane fx:id="sectorChart" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="STOCK IMPACT" styleClass="panel-title"/><TableView fx:id="table" minHeight="230" prefHeight="230" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></VBox></VBox></ScrollPane>
