<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.SettingsController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Settings" styleClass="page-title"/><Label text="Preferences, security and your simulation data." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox></HBox><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="PROFILE" styleClass="panel-title"/><GridPane fx:id="profileGrid" styleClass="form-grid"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="PREFERENCES" styleClass="panel-title"/><CheckBox fx:id="confirmBox" text="Ask me to confirm every trade"/><Label text="Export folder (blank uses the default)" styleClass="muted"/><HBox spacing="10"><TextField fx:id="exportField" HBox.hgrow="ALWAYS"/><Button text="Browse…" onAction="#browse" minWidth="-Infinity"/></HBox><Button text="Save preferences" onAction="#savePreferences" styleClass="primary" minWidth="-Infinity"/></VBox></HBox><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="CHANGE PASSWORD" styleClass="panel-title"/><PasswordField fx:id="currentField" promptText="Current password"/><PasswordField fx:id="newField" promptText="New password (8+ characters)"/><PasswordField fx:id="repeatField" promptText="Repeat new password"/><Button text="Change password" onAction="#changePassword" minWidth="-Infinity"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="DATA SOURCE" styleClass="panel-title"/><Label text="" styleClass="muted" wrapText="true" minHeight="-Infinity" fx:id="dataLabel"/><Label text="SIMULATION SNAPSHOT" styleClass="panel-title"/><Label text="A snapshot is a read-only record of your position, saved to a file. It cannot overwrite your account." styleClass="muted" wrapText="true" minHeight="-Infinity"/><Label text="" styleClass="accent" wrapText="true" minHeight="-Infinity" fx:id="snapshotLabel"/><Button text="Save snapshot" onAction="#saveSnapshot" minWidth="-Infinity"/></VBox></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="RESET SIMULATION" styleClass="panel-title"/><Label text="Erases your holdings, trades, scenario runs and simulated prices, and restores your starting capital. Enter your password to confirm." styleClass="muted" wrapText="true" minHeight="-Infinity"/><HBox spacing="10"><PasswordField fx:id="resetField" promptText="Password" prefWidth="260"/><Button text="Reset my simulation" onAction="#reset" styleClass="danger" minWidth="-Infinity"/></HBox></VBox></VBox>
