<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.WatchlistController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Watchlist" styleClass="page-title"/><Label text="Stocks you want to follow." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox></HBox><HBox spacing="10"><ComboBox fx:id="addBox" prefWidth="300"/><Button fx:id="addButton" text="Add to watchlist" onAction="#add" styleClass="primary" minWidth="-Infinity"/></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="WATCHED STOCKS" styleClass="panel-title"/><TableView fx:id="table" minHeight="420" prefHeight="420" minWidth="0" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button fx:id="detailsButton" text="Open details" onAction="#details" minWidth="-Infinity"/><Button fx:id="alertButton" text="Create alert" onAction="#createAlert" minWidth="-Infinity"/><Button fx:id="buyButton" text="BUY" onAction="#buy" styleClass="buy" minWidth="-Infinity"/><Button fx:id="removeButton" text="Remove" onAction="#remove" styleClass="danger" minWidth="-Infinity"/></HBox></VBox></VBox>
