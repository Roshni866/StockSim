<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane styleClass="auth-screen" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.LoginController"><ScrollPane fitToWidth="true" fitToHeight="true" styleClass="auth-scroll"><StackPane><VBox styleClass="auth-card" spacing="10" maxWidth="420" maxHeight="-Infinity"><StackPane.margin><Insets top="24" bottom="24" left="16" right="16"/></StackPane.margin><Label text="STOCKSIM" styleClass="brand-large"/><Label text="Sign in" styleClass="page-title"/><Label text="Username or email" styleClass="muted"/><TextField fx:id="identifierField" promptText="e.g. asha or asha@example.com"/><Label text="Password" styleClass="muted"/><PasswordField fx:id="passwordField" onAction="#login"/><Label text="" styleClass="error-label" wrapText="true" minHeight="-Infinity" fx:id="errorLabel"/><Button fx:id="loginButton" text="Sign in" onAction="#login" styleClass="primary" minWidth="-Infinity" maxWidth="Infinity" defaultButton="true"/><HBox spacing="10"><Button text="Create an account" onAction="#openRegister" styleClass="link-button" minWidth="-Infinity"/><Button text="Back" onAction="#back" styleClass="link-button" minWidth="-Infinity"/></HBox></VBox></StackPane></ScrollPane></StackPane>
