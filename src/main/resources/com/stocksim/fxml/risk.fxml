<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.RiskController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Risk Analytics" styleClass="page-title"/><Label text="Measures of past behaviour and concentration. No portfolio holding shares is risk-free." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox><Button text="Try a custom stress test" onAction="#openWhatIf" minWidth="-Infinity"/></HBox><FlowPane fx:id="metrics" hgap="8" vgap="8" styleClass="metric-strip"/><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="CONCENTRATION WARNINGS" styleClass="panel-title"/><VBox fx:id="warningsBox" spacing="6"/></VBox><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="STOCK EXPOSURE" styleClass="panel-title"/><StackPane fx:id="stockPie" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="SECTOR EXPOSURE" styleClass="panel-title"/><StackPane fx:id="sectorPie" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="CORRELATION OF DAILY RETURNS" styleClass="panel-title"/><Label text="+1 means two stocks moved together, 0 means no linear relationship, -1 means they moved in opposite directions. Highly correlated holdings diversify less." styleClass="muted" wrapText="true" minHeight="-Infinity"/><StackPane fx:id="correlationBox" minHeight="120" alignment="CENTER_LEFT"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="STRESS TESTING" styleClass="panel-title"/><Label text="Each row applies an invented price shock to your current holdings to show how much value is exposed. These are not predictions." styleClass="muted" wrapText="true" minHeight="-Infinity"/><TableView fx:id="stressTable" minHeight="220" prefHeight="220" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></VBox>
