<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane styleClass="auth-screen" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.RegisterController"><ScrollPane fitToWidth="true" fitToHeight="true" styleClass="auth-scroll"><StackPane><VBox styleClass="auth-card" spacing="10" maxWidth="420" maxHeight="-Infinity"><StackPane.margin><Insets top="24" bottom="24" left="16" right="16"/></StackPane.margin><Label text="STOCKSIM" styleClass="brand-large"/><Label text="Create your account" styleClass="page-title"/><Label text="Full name" styleClass="muted"/><TextField fx:id="nameField" promptText="Your name"/><Label text="Username" styleClass="muted"/><TextField fx:id="usernameField" promptText="3 or more letters, digits or _"/><Label text="Email" styleClass="muted"/><TextField fx:id="emailField" promptText="name@example.com"/><Label text="Password" styleClass="muted"/><PasswordField fx:id="passwordField" promptText="At least 8 characters"/><Label text="Confirm password" styleClass="muted"/><PasswordField fx:id="confirmField" promptText="Repeat the password"/><Label text="" styleClass="error-label" wrapText="true" minHeight="-Infinity" fx:id="errorLabel"/><Button fx:id="registerButton" text="Create account" onAction="#register" styleClass="primary" minWidth="-Infinity" maxWidth="Infinity" defaultButton="true"/><HBox spacing="10"><Button text="I already have an account" onAction="#openLogin" styleClass="link-button" minWidth="-Infinity"/><Button text="Back" onAction="#back" styleClass="link-button" minWidth="-Infinity"/></HBox></VBox></StackPane></ScrollPane></StackPane>
