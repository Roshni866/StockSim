<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.StockController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Stock Analysis" styleClass="page-title"/><Label text="Describes past simulated prices. It does not predict future prices." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox><Button text="← Market" onAction="#back" minWidth="-Infinity"/><ComboBox fx:id="stockBox" prefWidth="270"/><Button text="BUY" onAction="#buy" styleClass="buy" minWidth="-Infinity"/><Button text="SELL" onAction="#sell" styleClass="sell" minWidth="-Infinity"/><Button text="☆ Watch" onAction="#watch" minWidth="-Infinity"/><Button text="Create alert" onAction="#createAlert" minWidth="-Infinity"/></HBox><FlowPane fx:id="metrics" hgap="8" vgap="8" styleClass="metric-strip"/><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="PRICE CHART" styleClass="panel-title"/><HBox spacing="12" alignment="CENTER_LEFT"><HBox fx:id="periodBox" styleClass="segmented"/><CheckBox fx:id="ma5Box" text="5-day average" selected="true"/><CheckBox fx:id="ma20Box" text="20-day average" selected="true"/></HBox><StackPane fx:id="chart" minHeight="320" prefHeight="320" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/><Label text="" styleClass="muted" wrapText="true" minHeight="-Infinity" fx:id="chartNote"/></VBox><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="560"><Label text="INDICATORS" styleClass="panel-title"/><GridPane fx:id="indicatorGrid" styleClass="form-grid"/></VBox><VBox spacing="10" prefWidth="380" HBox.hgrow="ALWAYS"><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="CLASSIFICATION" styleClass="panel-title"/><GridPane fx:id="classGrid" styleClass="form-grid"/><Label text="Trend compares price with its moving averages, momentum uses the 10-day change and risk uses volatility." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="PRICE HISTORY (LATEST FIRST)" styleClass="panel-title"/><TableView fx:id="priceTable" minHeight="260" prefHeight="260" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></VBox></HBox></VBox>
