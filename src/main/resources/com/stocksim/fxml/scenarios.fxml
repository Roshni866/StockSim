<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" styleClass="content-scroll" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.ScenariosController"><VBox styleClass="page" spacing="10"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Market Scenarios" styleClass="page-title"/><Label text="HYPOTHETICAL: scenarios are invented rules for learning, not forecasts. One can run at a time." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox><HBox fx:id="controlsBox" alignment="CENTER_RIGHT" minWidth="-Infinity"/></HBox><VBox fx:id="activeBox" styleClass="panel,active-scenario" spacing="8"><Label text="" styleClass="accent" wrapText="true" minHeight="-Infinity" fx:id="activeLabel"/><ProgressBar fx:id="progress" maxWidth="Infinity"/><HBox spacing="10"><Button text="Run to the end" onAction="#runToEnd" styleClass="primary" minWidth="-Infinity"/><Button text="Cancel scenario" onAction="#cancel" minWidth="-Infinity"/></HBox></VBox><FlowPane fx:id="cards" hgap="10" vgap="10"/><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="YOUR SCENARIO RUNS (SELECT ONE TO INSPECT)" styleClass="panel-title"/><TableView fx:id="runTable" minHeight="170" prefHeight="170" minWidth="0" VBox.vgrow="ALWAYS"/></VBox><VBox fx:id="resultBox" spacing="10"><HBox spacing="10"><Label text="" styleClass="card-title" fx:id="resultTitle" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Export CSV" onAction="#export" minWidth="-Infinity"/></HBox><Label text="" styleClass="summary" wrapText="true" minHeight="-Infinity" fx:id="summaryLabel"/><FlowPane fx:id="resultMetrics" hgap="8" vgap="8" styleClass="metric-strip"/><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="460"><Label text="SECTOR IMPACT (%)" styleClass="panel-title"/><StackPane fx:id="sectorChart" minHeight="250" prefHeight="250" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="460"><Label text="STOCK IMPACT (BEST FIRST)" styleClass="panel-title"/><TableView fx:id="stockTable" minHeight="250" prefHeight="250" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></HBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="YOUR TRADING DURING THIS SCENARIO" styleClass="panel-title"/><TableView fx:id="tradeTable" minHeight="160" prefHeight="160" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></VBox></VBox></ScrollPane>
