<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="lab" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.GoalsController"><TabPane fx:id="tabs" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"><tabs><Tab text="Investment Goals"><content><VBox styleClass="page" spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="GOAL" styleClass="panel-title"/><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="goalName" promptText="Goal name" prefWidth="240"/><TextField fx:id="goalTarget" promptText="Target portfolio value (₹)" prefWidth="220"/><Button text="Create goal" onAction="#createGoal" styleClass="primary" minWidth="-Infinity"/><Button fx:id="updateButton" text="Save changes" onAction="#updateGoal" minWidth="-Infinity"/><Button fx:id="deleteGoalButton" text="Delete" onAction="#deleteGoal" styleClass="danger" minWidth="-Infinity"/></HBox><Label text="Progress is your current portfolio value as a share of the target. Select a goal to edit it." styleClass="muted" wrapText="true" minHeight="-Infinity"/><Label text="" styleClass="error-label" wrapText="true" minHeight="-Infinity" fx:id="goalError"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="YOUR GOALS" styleClass="panel-title"/><TableView fx:id="goalTable" minHeight="360" prefHeight="360" minWidth="0" VBox.vgrow="ALWAYS"/></VBox></VBox></content></Tab><Tab text="Price Alerts"><content><VBox styleClass="page" spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="NEW PRICE ALERT" styleClass="panel-title"/><HBox spacing="8" alignment="CENTER_LEFT"><ComboBox fx:id="alertStock" prefWidth="260"/><ComboBox fx:id="alertDirection" prefWidth="100"/><TextField fx:id="alertTarget" promptText="Target price (₹)" prefWidth="170"/><Button text="Create alert" onAction="#createAlert" styleClass="primary" minWidth="-Infinity"/></HBox><Label text="" styleClass="accent" fx:id="alertPrice"/><Label text="Alerts are checked against closing prices each time you advance the simulation." styleClass="muted" wrapText="true" minHeight="-Infinity"/><Label text="" styleClass="error-label" wrapText="true" minHeight="-Infinity" fx:id="alertError"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="ACTIVE ALERTS" styleClass="panel-title"/><TableView fx:id="activeTable" minHeight="190" prefHeight="190" minWidth="0" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button text="Delete selected" onAction="#deleteActive" styleClass="danger" minWidth="-Infinity"/></HBox></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="TRIGGERED ALERTS" styleClass="panel-title"/><TableView fx:id="triggeredTable" minHeight="190" prefHeight="190" minWidth="0" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button text="Delete selected" onAction="#deleteTriggered" styleClass="danger" minWidth="-Infinity"/></HBox></VBox></VBox></content></Tab></tabs></TabPane></VBox>
