<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.MarketController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Market Terminal" styleClass="page-title"/><Label text="Simulated prices as of your current simulation day. Double-click a row for full analysis." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox></HBox><HBox spacing="8" alignment="CENTER_LEFT"><TextField fx:id="searchField" promptText="Search company, symbol or sector" prefWidth="280"/><ComboBox fx:id="sectorBox"/><Label text="Sort" styleClass="muted"/><ComboBox fx:id="sortBox"/><CheckBox fx:id="watchedBox" text="Watchlist only"/></HBox><HBox spacing="10" VBox.vgrow="ALWAYS"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="800"><Label text="INSTRUMENTS" styleClass="panel-title"/><TableView fx:id="table" minHeight="520" prefHeight="520" minWidth="0" VBox.vgrow="ALWAYS"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" minWidth="260" prefWidth="320"><Label text="SELECTED STOCK" styleClass="panel-title"/><Label text="" styleClass="card-title" wrapText="true" minHeight="-Infinity" fx:id="nameLabel"/><Label text="" styleClass="big-price" fx:id="priceLabel"/><GridPane fx:id="detailGrid" styleClass="form-grid"/><StackPane fx:id="miniChart" minHeight="190" prefHeight="190" minWidth="0" prefWidth="280" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button fx:id="buyButton" text="BUY" onAction="#buy" styleClass="buy" minWidth="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button fx:id="sellButton" text="SELL" onAction="#sell" styleClass="sell" minWidth="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS"/></HBox><Button fx:id="analyseButton" text="Open full analysis" onAction="#analyse" minWidth="-Infinity" maxWidth="Infinity"/><Button fx:id="watchButton" text="☆ Add to watchlist" onAction="#toggleWatch" minWidth="-Infinity" maxWidth="Infinity"/></VBox></HBox></VBox>
