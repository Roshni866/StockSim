<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="page" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stocksim.controller.PortfolioController"><HBox spacing="10" alignment="CENTER_LEFT"><VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Portfolio" styleClass="page-title"/><Label text="Holdings are valued at your current simulated prices. Cost uses the average-cost method." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox><Button text="Export CSV" onAction="#export" minWidth="-Infinity"/></HBox><FlowPane fx:id="metrics" hgap="8" vgap="8" styleClass="metric-strip"/><FlowPane fx:id="performers" hgap="8" vgap="8" styleClass="metric-strip"/><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="HOLDINGS" styleClass="panel-title"/><TableView fx:id="table" minHeight="250" prefHeight="250" minWidth="0" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button fx:id="analyseButton" text="Analyse" onAction="#analyse" minWidth="-Infinity"/><Button fx:id="buyButton" text="BUY" onAction="#buy" styleClass="buy" minWidth="-Infinity"/><Button fx:id="sellButton" text="SELL" onAction="#sell" styleClass="sell" minWidth="-Infinity"/></HBox></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity"><Label text="PORTFOLIO HISTORY" styleClass="panel-title"/><StackPane fx:id="historyChart" minHeight="280" prefHeight="280" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox><HBox spacing="10"><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="STOCK ALLOCATION" styleClass="panel-title"/><StackPane fx:id="stockPie" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox><VBox styleClass="panel" spacing="8" maxWidth="Infinity" HBox.hgrow="ALWAYS"><Label text="SECTOR ALLOCATION" styleClass="panel-title"/><StackPane fx:id="sectorPie" minHeight="260" prefHeight="260" minWidth="0" prefWidth="300" VBox.vgrow="ALWAYS"/></VBox></HBox></VBox>
